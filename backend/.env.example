# Copy to .env and fill in values
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/interviewlens
SECRET_KEY=change-me-to-a-long-random-string-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Judge0 CE public instance (no key needed for low volume)
JUDGE0_URL=https://ce.judge0.com

# CORS origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Environment
ENV=development

# Frontend origin — OAuth redirects send the browser back here
FRONTEND_URL=http://localhost:5173

# OAuth (optional — leave blank to disable Google/GitHub sign-in)
# Register the callback URL below with each provider.
OAUTH_REDIRECT_URI=http://localhost:5173/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Candidate invite emails (leave SMTP_HOST empty to save emails to ./outbox instead)
# Gmail: enable 2-Step Verification, then create an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=InterviewLens <you@example.com>
